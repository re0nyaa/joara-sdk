{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "types": ["node", "jest"],
        "outDir": "./dist"
    },
    "include": ["src/**/*", "index.ts", "test/**/*"]
}
