{
    "name": "joara-sdk",
    "version": "1.0.13",
    "description": "Joara 비공식 TypeScript API 클라이언트",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "module": "./dist/index.js",
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/re0nyaa/joara-sdk.git"
    },
    "bugs": {
        "url": "https://github.com/re0nyaa/joara-sdk/issues"
    },
    "homepage": "https://github.com/re0nyaa/joara-sdk#readme",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js",
            "require": "./dist/client.js"
        },
        "./types": {
            "types": "./dist/types.d.ts",
            "import": "./dist/types.js",
            "require": "./dist/types.js"
        },
        "./errors": {
            "types": "./dist/errors.d.ts",
            "import": "./dist/errors.js",
            "require": "./dist/errors.js"
        },
        "./cache": {
            "types": "./dist/cache.d.ts",
            "import": "./dist/cache.js",
            "require": "./dist/cache.js"
        },
        "./retry": {
            "types": "./dist/retry.d.ts",
            "import": "./dist/retry.js",
            "require": "./dist/retry.js"
        },
        "./parser": {
            "types": "./dist/parser.d.ts",
            "import": "./dist/parser.js",
            "require": "./dist/parser.js"
        }
    },
    "scripts": {
        "start": "node --import tsx src/index.ts",
        "build": "npm run test && tsc -p tsconfig.build.json",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs"
    },
    "dependencies": {
        "undici": "^6.21.1"
    },
    "devDependencies": {
        "@jest/globals": "^30.4.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "jest": "^30.4.2",
        "ts-jest": "^29.4.12",
        "tsx": "^4.19.0",
        "typescript": "^5.5.0"
    }
}
